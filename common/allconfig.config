
# Team mailboxes offered in the report "Send Email" dropdown: <display name>=<email>[;<email>...]
[email_contacts]
CT47_A14=xiaohan.gao@honeywell.com;Sophy.Yan@Honeywell.com

# Sophy_H400818_2026-09-01: parameters for the Keyremap  -> TEXT test case (ANDROIDCN-36228)
[keyremap_text_case]
# Keyremap TEXT targets take comma-separated characters; the key then emits them joined.
remap_text_input=T,E,S,T
expected_text=test
# Ctrl+A shortcut, selects all text in the focused field.
select_all_input=CTRL_LEFT,A
probe_text=hello
# A character plus a volume step: one press types 'a' and raises the volume.
text_and_volume_input=A,VOLUME_UP
step5_press_count=3
volume_streams=STREAM_MUSIC,STREAM_RING
# Baseline volume applied before the VOLUME_UP presses so the stream is not already at max.
volume_stream_name=STREAM_MUSIC
default_volume_index=5

# Sophy_H400818_2026-09-02: parameters for the Keyremap HOME -> APPS test case (ANDROIDCN-33165)
[keyremap_apps_case]
# APK shipped under files/apps/, installed by the test before the remap is created.
apk_file_name=app-debug-20260715-hon660-signed.apk
app_package=com.honeywell.stresstest
# Label shown in the Keyremap APPS target list (aapt application-label).
app_label=StressTest
# Step 5 re-maps the same key to a preinstalled app to prove the target can be switched.
scandemo_app_package=com.honeywell.demos.scandemo
scandemo_app_label=Scan Demo
# Step 6 re-maps it again to EZMenu; the APPS list shows the app under its own label.
powertool_app_package=com.honeywell.tools.ezmenu
powertool_app_label=EZMenu
# Additional HOME -> APPS targets.
chrome_app_package=com.android.chrome
chrome_app_label=Chrome
calculator_app_package=com.android.calculator2,com.google.android.calculator,com.caluclator
calculator_app_label=Calculator
calendar_app_package=com.android.calendar,com.google.android.calendar
calendar_app_label=Calendar
clock_app_package=com.android.deskclock,com.google.android.deskclock
clock_app_label=Clock
files_app_package=com.android.documentsui
files_app_label=Files
settings_app_package=com.android.settings
settings_app_label=Settings
play_store_app_package=com.android.vending
play_store_app_label=Google Play Store
hupgrader_app_package=com.honeywell.tool.hupgrader
hupgrader_app_label=HUpgrader
phone_app_package=com.android.dialer,com.google.android.dialer
phone_app_label=Phone
scanedge_app_package=com.honeywell.scanedge
scanedge_app_label=Scanner Edge
snapdragon_camera_app_package=org.codeaurora.snapcam
snapdragon_camera_app_label=Snapdragon Camera

# Sophy_H400818_2026-09-04: parameters for the Keyremap APP_SWITCH -> COMMAND test case
[keyremap_command_case]
apk_file_name=LockAction-signed.apk
app_package=com.honeywell.test.lockaction
remap_command=am start -a android.intent.action.APRIVA_STARTACTIVITY
broadcast_command=am broadcast -a android.intent.action.APRIVA_BROADCAST -p com.honeywell.test.lockaction
broadcast_received_text=Broadcast Received
service_command=am startservice -a android.intent.action.APRIVA_STARTSERVICE
service_started_text=Service started
view_command=am start -a android.intent.action.VIEW -d http://developer.android.com
view_url=developer.android.com

# Sophy_H400818_2026-09-08: parameters for the EZConfig HOME -> ENTER provisioning test (ANDROIDCN-33957)
[keyremap_provisioning_case]
provisioning_mode_label=Provisioning Mode
ezconfig_entry_label=EZConfig
generator_labels=Generator,Local XML Generator
device_config_label=DeviceConfig
honeywell_settings_node_label=Honeywell Settings
keyremap_node_label=KeyRemap
ignore_keyremap_to_ptt_label=ignore keyRemap to PTT
# EZConfig's HOME target syntax; the KeyRemap app shows this row as HOME -> ENTER.
remap_value=HOME-ENTER
save_label=Save
update_configures_label=Update Configure
probe_text=ENTERTEST